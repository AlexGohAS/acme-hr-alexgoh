# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Lab 4: your free Render Postgres -> Connect -> External Database URL (postgres://...).
# Leave empty until then: the API uses a local SQLite file.
DATABASE_URL=

# Your own private password for the training accounts. Required as soon as DATABASE_URL is set (Lab 4):
# the API refuses to start on Postgres without it, because Acme@2026 is public. Local SQLite uses Acme@2026.
# Used only when the database is first created.
SEED_USER_PASSWORD=
