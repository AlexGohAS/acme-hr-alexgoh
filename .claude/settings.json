{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet run *)",
      "Bash(npm run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx tsc *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.production)",
      "Read(/**/.env.local)",
      "Read(/**/.env)",
      "Read(/secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/run-tests.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/block-secrets.js\""
          }
        ]
      }
    ]
  }
}
